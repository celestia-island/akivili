//! The celestia plugin-fabric host contract, world v0.
//!
//! This is the WIT world an F1 (`wasm.component`) plugin is written
//! against: the plugin *imports* the host API (log / kv / config —
//! the v0 slice of the closed capability vocabulary) and *exports*
//! its entry point. The host side lives in `akivili_wasm_host`
//! (feature `tairitsu`); guests bind with `wit_bindgen::generate!`
//! against this file.
//!
//! v0 scope is deliberately narrow (Celestia Plugin Fabric B1):
//! string-keyed capabilities only, sync host functions. Async host
//! functions require wasmtime's `wasm_component_model_async` ABI and
//! arrive with the fabric's async-ABI wave.
//!
//! Contract reference form (akivili_registry::ContractRef): the
//! canonical reference to this world is `celestia:host/guest@0.1` —
//! the two-part version is a compatibility constraint over the WIT
//! package's semver (`0.1` covers `0.1.x`).

package celestia:host@0.1.0;

world guest {
    /// Structured logging through the host (capability `log`).
    import log: func(level: string, message: string);

    /// Plugin-scoped key/value state (capability `kv.read`).
    import kv-get: func(key: string) -> option<string>;
    /// Plugin-scoped key/value state (capability `kv.write`).
    import kv-set: func(key: string, value: string);

    /// The plugin's own configuration section (capability
    /// `config.read`).
    import config-get: func(key: string) -> option<string>;

    /// The plugin's entry point. `payload` is call-dependent
    /// (a webhook request, a message event, a panel action); the
    /// answer rides the call's result.
    export run: func(payload: string) -> result<string, string>;
}
